function moveUp(id) {
  const parent = findParent(id);
  const list = parent ? parent.children : db.rootIds;
  const i = list.indexOf(id);
  if (i > 0) { [list[i-1], list[i]] = [list[i], list[i-1]]; saveDB(); renderTree(); }
}
function moveDown(id) {
  const parent = findParent(id);
  const list = parent ? parent.children : db.rootIds;
  const i = list.indexOf(id);
  if (i >= 0 && i < list.length - 1) { [list[i+1], list[i]] = [list[i], list[i+1]]; saveDB(); renderTree(); }
}
function moveToDialog(srcId) {
  // Llista de possibles destinacions en un modal simple
  const options = [];
  const collect = (ids, prefix) => {
    for (const id of ids) {
      if (id === srcId || isDescendant(id, srcId)) continue;
      options.push({ id, label: prefix + db.nodes[id].title });
      collect(db.nodes[id].children, prefix + '  ');
    }
  };
  collect(db.rootIds, '');
  const choice = prompt('Escriu el número de la nota destí:\n\n' +
    options.map((o,i) => `${i+1}. ${o.label}`).join('\n'));
  const n = parseInt(choice);
  if (n >= 1 && n <= options.length) moveNote(srcId, options[n-1].id, 'child');
}

/* ---- Import / Export ---- */
function exportDB() {
  flushEditor();
  const blob = new Blob([JSON.stringify(db, null, 2)], { type:'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'treenotes-' + new Date().toISOString().slice(0,10) + '.json';
  a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  setStatus('BD exportada');
}
function importDB(ev) {
  const file = ev.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = async () => {
    try {
      const data = JSON.parse(reader.result);
      if (!data.nodes || !data.rootIds) throw new Error('Format incorrecte');
      const ok = await openConfirm('Substituir la BD actual?', true, 'Substitueix');
      if (!ok) return;
      db = data;
      saveDB(); renderTree();
      selectNote(db.selected || db.rootIds[0]);
      setStatus('BD importada');
    } catch(err) { alert('Error important: ' + err.message); }
    ev.target.value = '';
  };
  reader.readAsText(file);
}
