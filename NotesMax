<!DOCTYPE html>
<html lang="ca">
<head>
<meta charset="UTF-8">
<title>TreeNotes</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; font-family: system-ui, sans-serif; font-size: 14px; }
  body { display: flex; flex-direction: column; background: #f4f5f7; color: #222; }

  /* ---- Barra superior ---- */
  #toolbar {
    display: flex; align-items: center; gap: 6px;
    padding: 6px 10px; background: #2d3748; color: #fff;
    flex-wrap: wrap;
  }
  #toolbar button, #toolbar label.btn {
    background: #4a5568; color: #fff; border: none; border-radius: 4px;
    padding: 5px 10px; cursor: pointer; font-size: 13px;
  }
  #toolbar button:hover, #toolbar label.btn:hover { background: #5a6a82; }
  #toolbar .sep { width: 1px; height: 22px; background: #5a6a82; margin: 0 4px; }
  #toolbar .title { font-weight: 600; margin-right: 10px; }
  #fileInput { display: none; }

  /* ---- Layout principal ---- */
  #main { flex: 1; display: flex; overflow: hidden; }

  /* ---- Arbre ---- */
  #treePane {
    width: 300px; min-width: 180px; overflow-y: auto;
    background: #fff; border-right: 1px solid #d1d5db;
    padding: 8px 4px;
  }
  .node {
    display: flex; align-items: center;
    padding: 3px 6px; border-radius: 4px;
    cursor: pointer; user-select: none;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .node:hover { background: #edf2f7; }
  .node.selected { background: #3182ce; color: #fff; }
  .node.drag-over { background: #f6e05e; color: #222; }
  .node.drag-over-child { background: #68d391; color: #222; }
  .node .arrow {
    width: 14px; display: inline-block; text-align: center;
    font-size: 10px; color: #666;
  }
  .node.selected .arrow { color: #fff; }
  .node .label { flex: 1; overflow: hidden; text-overflow: ellipsis; }
  .children { margin-left: 14px; }

  /* ---- Editor ---- */
  #editorPane {
    flex: 1; display: flex; flex-direction: column;
    background: #fff; overflow: hidden;
  }
  #noteTitle {
    font-size: 18px; font-weight: 600;
    border: none; outline: none;
    padding: 12px 16px; border-bottom: 1px solid #e2e8f0;
  }
  #formatBar {
    display: flex; flex-wrap: wrap; gap: 4px;
    padding: 6px 10px; border-bottom: 1px solid #e2e8f0; background: #fafafa;
  }
  #formatBar button {
    background: #fff; border: 1px solid #cbd5e0; border-radius: 4px;
    padding: 4px 8px; cursor: pointer; font-size: 13px;
  }
  #formatBar button:hover { background: #edf2f7; }
  #formatBar select {
    border: 1px solid #cbd5e0; border-radius: 4px; padding: 4px; background:#fff;
  }
  #formatBar .sep { width: 1px; background: #cbd5e0; margin: 0 4px; }

  #noteBody {
    flex: 1; overflow-y: auto; padding: 16px 20px;
    outline: none; line-height: 1.6;
  }
  #noteBody:empty:before {
    content: "Escriu aquí…";
    color: #a0aec0;
  }
  #noteBody h1 { font-size: 1.6em; margin: 0.5em 0; }
  #noteBody h2 { font-size: 1.35em; margin: 0.5em 0; }
  #noteBody h3 { font-size: 1.15em; margin: 0.5em 0; }
  #noteBody p { margin: 0.4em 0; }
  #noteBody ul, #noteBody ol { margin: 0.4em 0 0.4em 1.4em; }
  #noteBody blockquote {
    border-left: 3px solid #cbd5e0; padding-left: 10px; color: #555; margin: 0.4em 0;
  }
  #noteBody pre {
    background: #f7fafc; border: 1px solid #e2e8f0; border-radius: 4px;
    padding: 8px; font-family: monospace; white-space: pre-wrap; margin: 0.4em 0;
  }
  #noteBody a { color: #3182ce; }
  #noteBody table { border-collapse: collapse; margin: 0.4em 0; }
  #noteBody table td, #noteBody table th {
    border: 1px solid #cbd5e0; padding: 4px 8px;
  }

  /* ---- Estat ---- */
  #status {
    padding: 4px 10px; background: #edf2f7; color: #555;
    font-size: 12px; border-top: 1px solid #d1d5db;
    display: flex; justify-content: space-between;
  }

  /* ---- Menú contextual ---- */
  #ctxMenu {
    position: fixed; background: #fff; border: 1px solid #cbd5e0;
    border-radius: 4px; box-shadow: 0 4px 12px rgba(0,0,0,.15);
    padding: 4px; display: none; z-index: 1000; min-width: 180px;
  }
  #ctxMenu div {
    padding: 6px 10px; cursor: pointer; border-radius: 3px; font-size: 13px;
  }
  #ctxMenu div:hover { background: #edf2f7; }
  #ctxMenu .danger { color: #c53030; }
</style>
</head>
<body>

<div id="toolbar">
  <span class="title">🌳 TreeNotes</span>
  <button onclick="addNote(null, 'child')">+ Nota filla</button>
  <button onclick="addNote(null, 'sibling')">+ Nota germana</button>
  <span class="sep"></span>
  <button onclick="renameNote()">✏️ Reanomena</button>
  <button onclick="deleteNote()">🗑️ Esborra</button>
  <span class="sep"></span>
  <button onclick="expandAll(true)">⬇️ Expandeix</button>
  <button onclick="expandAll(false)">➡️ Replega</button>
  <span class="sep"></span>
  <button onclick="exportDB()">💾 Exporta BD</button>
  <label class="btn" for="fileInput">📂 Importa BD</label>
  <input type="file" id="fileInput" accept=".json" onchange="importDB(event)">
  <button onclick="exportHTML()">🌐 Exporta HTML</button>
  <span class="sep"></span>
  <button onclick="newDB()">✨ Nova BD</button>
</div>

<div id="main">
  <div id="treePane"><div id="tree"></div></div>
  <div id="editorPane">
    <input id="noteTitle" placeholder="Títol de la nota" oninput="onTitleChange()">
    <div id="formatBar">
      <button onmousedown="event.preventDefault()" onclick="fmt('bold')"><b>B</b></button>
      <button onmousedown="event.preventDefault()" onclick="fmt('italic')"><i>I</i></button>
      <button onmousedown="event.preventDefault()" onclick="fmt('underline')"><u>U</u></button>
      <button onmousedown="event.preventDefault()" onclick="fmt('strikeThrough')"><s>S</s></button>
      <span class="sep"></span>
      <select onchange="fmtBlock(this.value); this.value='';">
        <option value="">Format…</option>
        <option value="p">Paràgraf</option>
        <option value="h1">Títol 1</option>
        <option value="h2">Títol 2</option>
        <option value="h3">Títol 3</option>
        <option value="pre">Codi</option>
        <option value="blockquote">Cita</option>
      </select>
      <button onmousedown="event.preventDefault()" onclick="fmt('insertUnorderedList')">• Llista</button>
      <button onmousedown="event.preventDefault()" onclick="fmt('insertOrderedList')">1. Llista</button>
      <span class="sep"></span>
      <button onmousedown="event.preventDefault()" onclick="setColor('#c53030')">🔴</button>
      <button onmousedown="event.preventDefault()" onclick="setColor('#2b6cb0')">🔵</button>
      <button onmousedown="event.preventDefault()" onclick="setColor('#2f855a')">🟢</button>
      <input type="color" title="Color text" oninput="setColor(this.value)" style="width:28px;height:26px;padding:0;border:1px solid #cbd5e0;border-radius:4px;">
      <button onmousedown="event.preventDefault()" onclick="setHighlight('#fefcbf')">🖍️</button>
      <span class="sep"></span>
      <button onmousedown="event.preventDefault()" onclick="insertLink()">🔗 Enllaç</button>
      <button onmousedown="event.preventDefault()" onclick="insertHR()">—</button>
      <button onmousedown="event.preventDefault()" onclick="insertTable()">▦ Taula</button>
      <button onmousedown="event.preventDefault()" onclick="insertCode()">&lt;/&gt; Codi</button>
      <button onmousedown="event.preventDefault()" onclick="document.execCommand('removeFormat')">🧹 Neteja</button>
    </div>
    <div id="noteBody" contenteditable="true" oninput="onBodyChange()"></div>
  </div>
</div>

<div id="status">
  <span id="statusLeft">Preparat</span>
  <span id="statusRight"></span>
</div>

<div id="ctxMenu"></div>

<script>
/* =========================================================
   TreeNotes — base de dades en localStorage
   Estructura:
   {
     rootIds: [...],
     nodes: { id: { id, title, html, children:[], collapsed:false } },
     selected: id
   }
   ========================================================= */

const LS_KEY = 'treenotes_db_v1';
let db = null;
let draggedId = null;

/* ---------- Utilitats ---------- */
const uid = () => 'n' + Date.now().toString(36) + Math.random().toString(36).slice(2,7);
const $  = s => document.querySelector(s);
const $$ = s => document.querySelectorAll(s);

/* ---------- Crear / carregar BD ---------- */
function blankDB() {
  const id = uid();
  return {
    rootIds: [id],
    nodes: { [id]: { id, title:'Nota arrel', html:'<p>Benvingut a <b>TreeNotes</b>.</p>', children:[], collapsed:false } },
    selected: id
  };
}

function loadDB() {
  const raw = localStorage.getItem(LS_KEY);
  if (raw) { try { db = JSON.parse(raw); } catch(e){ db = blankDB(); } }
  else db = blankDB();
}

function saveDB(silent) {
  localStorage.setItem(LS_KEY, JSON.stringify(db));
  if (!silent) setStatus('Desat ' + new Date().toLocaleTimeString());
}

/* ---------- Arbre ---------- */
function renderTree() {
  const tree = $('#tree');
  tree.innerHTML = '';
  const build = (ids, container) => {
    for (const id of ids) {
      const n = db.nodes[id];
      if (!n) continue;
      const div = document.createElement('div');
      div.className = 'node' + (id === db.selected ? ' selected' : '');
      div.dataset.id = id;
      div.draggable = true;

      const arrow = document.createElement('span');
      arrow.className = 'arrow';
      arrow.textContent = n.children.length ? (n.collapsed ? '▶' : '▼') : '';
      arrow.onclick = (e) => { e.stopPropagation(); n.collapsed = !n.collapsed; saveDB(true); renderTree(); };

      const label = document.createElement('span');
      label.className = 'label';
      label.textContent = n.title || '(sense títol)';

      div.appendChild(arrow);
      div.appendChild(label);

      div.onclick = (e) => { e.stopPropagation(); selectNote(id); };
      div.oncontextmenu = (e) => { e.preventDefault(); openCtxMenu(e, id); };

      // Drag & drop
      div.ondragstart = (e) => { draggedId = id; e.dataTransfer.effectAllowed = 'move'; };
      div.ondragover = (e) => {
        if (!draggedId || draggedId === id) return;
        e.preventDefault();
        const rect = div.getBoundingClientRect();
        const y = e.clientY - rect.top;
        div.classList.remove('drag-over','drag-over-child');
        if (y < rect.height * 0.25) div.classList.add('drag-over');       // abans
        else if (y > rect.height * 0.75) div.classList.add('drag-over');  // després
        else div.classList.add('drag-over-child');                        // com a fill
      };
      div.ondragleave = () => div.classList.remove('drag-over','drag-over-child');
      div.ondrop = (e) => {
        e.preventDefault();
        const rect = div.getBoundingClientRect();
        const y = e.clientY - rect.top;
        div.classList.remove('drag-over','drag-over-child');
        if (y < rect.height * 0.25) moveNote(draggedId, id, 'before');
        else if (y > rect.height * 0.75) moveNote(draggedId, id, 'after');
        else moveNote(draggedId, id, 'child');
        draggedId = null;
      };

      container.appendChild(div);

      if (n.children.length && !n.collapsed) {
        const kids = document.createElement('div');
        kids.className = 'children';
        build(n.children, kids);
        container.appendChild(kids);
      }
    }
  };
  build(db.rootIds, tree);
}

/* ---------- Selecció / editor ---------- */
function selectNote(id) {
  flushEditor();
  db.selected = id;
  const n = db.nodes[id];
  if (!n) return;
  $('#noteTitle').value = n.title;
  $('#noteBody').innerHTML = n.html || '';
  renderTree();
}

function onTitleChange() {
  const n = db.nodes[db.selected];
  if (!n) return;
  n.title = $('#noteTitle').value;
  saveDB(true);
  renderTree();
}

function onBodyChange() {
  const n = db.nodes[db.selected];
  if (!n) return;
  n.html = $('#noteBody').innerHTML;
  clearTimeout(onBodyChange._t);
  onBodyChange._t = setTimeout(() => saveDB(true), 400);
}

function flushEditor() {
  const n = db.nodes[db.selected];
  if (!n) return;
  n.title = $('#noteTitle').value;
  n.html = $('#noteBody').innerHTML;
}

/* ---------- Crear / esborrar / moure ---------- */
function addNote(parentId, mode) {
  flushEditor();
  const id = uid();
  const newNode = { id, title:'Nova nota', html:'', children:[], collapsed:false };
  db.nodes[id] = newNode;

  if (mode === 'child') {
    const pid = parentId || db.selected;
    if (pid && db.nodes[pid]) {
      db.nodes[pid].children.push(id);
      db.nodes[pid].collapsed = false;
    } else {
      db.rootIds.push(id);
    }
  } else { // germana
    const sel = db.selected;
    if (!sel) { db.rootIds.push(id); }
    else {
      const parent = findParent(sel);
      if (parent) {
        const idx = parent.children.indexOf(sel);
        parent.children.splice(idx + 1, 0, id);
      } else {
        const idx = db.rootIds.indexOf(sel);
        db.rootIds.splice(idx + 1, 0, id);
      }
    }
  }
  db.selected = id;
  saveDB();
  renderTree();
  selectNote(id);
  setTimeout(() => $('#noteTitle').select(), 50);
}

function findParent(id) {
  for (const k in db.nodes) {
    if (db.nodes[k].children.includes(id)) return db.nodes[k];
  }
  return null;
}

function renameNote() {
  const n = db.nodes[db.selected];
  if (!n) return;
  const v = prompt('Nou títol:', n.title);
  if (v !== null) { n.title = v; saveDB(); renderTree(); $('#noteTitle').value = v; }
}

function deleteNote() {
  const id = db.selected;
  const n = db.nodes[id];
  if (!n) return;
  if (!confirm(`Esborrar "${n.title}" i tots els seus fills?`)) return;
  removeRecursive(id);
  // tria un altre node
  const anyId = db.rootIds[0] || Object.keys(db.nodes)[0];
  if (anyId) selectNote(anyId);
  else { db = blankDB(); }
  saveDB();
  renderTree();
}

function removeRecursive(id) {
  const n = db.nodes[id];
  if (!n) return;
  for (const c of [...n.children]) removeRecursive(c);
  const parent = findParent(id);
  if (parent) parent.children = parent.children.filter(x => x !== id);
  else db.rootIds = db.rootIds.filter(x => x !== id);
  delete db.nodes[id];
}

/* ---------- Drag & drop: moure ---------- */
function moveNote(srcId, targetId, position) {
  if (!srcId || srcId === targetId) return;
  if (isDescendant(targetId, srcId)) return; // evitar cicles

  // treure del lloc actual
  const srcNode = db.nodes[srcId];
  const oldParent = findParent(srcId);
  if (oldParent) oldParent.children = oldParent.children.filter(x => x !== srcId);
  else db.rootIds = db.rootIds.filter(x => x !== srcId);

  if (position === 'child') {
    db.nodes[targetId].children.push(srcId);
    db.nodes[targetId].collapsed = false;
  } else {
    const parent = findParent(targetId);
    if (parent) {
      const idx = parent.children.indexOf(targetId);
      parent.children.splice(position === 'before' ? idx : idx + 1, 0, srcId);
    } else {
      const idx = db.rootIds.indexOf(targetId);
      db.rootIds.splice(position === 'before' ? idx : idx + 1, 0, srcId);
    }
  }
  saveDB();
  renderTree();
  selectNote(srcId);
}

function isDescendant(maybeChild, ancestor) {
  const n = db.nodes[ancestor];
  if (!n) return false;
  if (n.children.includes(maybeChild)) return true;
  return n.children.some(c => isDescendant(maybeChild, c));
}

/* ---------- Format ---------- */
function fmt(cmd) {
  document.execCommand(cmd, false, null);
  $('#noteBody').focus();
  onBodyChange();
}
function fmtBlock(tag) {
  if (!tag) return;
  document.execCommand('formatBlock', false, tag);
  $('#noteBody').focus();
  onBodyChange();
}
function setColor(c) { document.execCommand('foreColor', false, c); $('#noteBody').focus(); onBodyChange(); }
function setHighlight(c) { document.execCommand('hiliteColor', false, c); $('#noteBody').focus(); onBodyChange(); }
function insertLink() {
  const url = prompt('URL:', 'https://');
  if (url) document.execCommand('createLink', false, url);
  $('#noteBody').focus(); onBodyChange();
}
function insertHR() { document.execCommand('insertHorizontalRule'); $('#noteBody').focus(); onBodyChange(); }
function insertCode() {
  const sel = window.getSelection();
  const text = sel.toString() || 'codi';
  document.execCommand('insertHTML', false, '<pre>' + text.replace(/</g,'&lt;') + '</pre>');
  onBodyChange();
}
function insertTable() {
  const r = parseInt(prompt('Files:', '3')) || 3;
  const c = parseInt(prompt('Columnes:', '3')) || 3;
  let html = '<table>';
  for (let i=0;i<r;i++){
    html += '<tr>';
    for (let j=0;j<c;j++){
      html += i===0 ? `<th>&nbsp;</th>` : `<td>&nbsp;</td>`;
    }
    html += '</tr>';
  }
  html += '</table><p><br></p>';
  document.execCommand('insertHTML', false, html);
  onBodyChange();
}

/* ---------- Expandir / replegar ---------- */
function expandAll(open) {
  for (const k in db.nodes) db.nodes[k].collapsed = !open;
  saveDB(true); renderTree();
}

/* ---------- Menú contextual ---------- */
function openCtxMenu(e, id) {
  const menu = $('#ctxMenu');
  menu.innerHTML = '';
  const items = [
    ['+ Nota filla',   () => addNote(id, 'child')],
    ['+ Nota germana', () => { selectNote(id); addNote(null, 'sibling'); }],
    ['✏️ Reanomena',   () => { selectNote(id); renameNote(); }],
    ['⬆️ Puja',        () => moveUp(id)],
    ['⬇️ Baixa',       () => moveDown(id)],
    ['🗑️ Esborra',     () => { selectNote(id); deleteNote(); }, 'danger'],
  ];
  items.forEach(([label, fn, cls]) => {
    const d = document.createElement('div');
    d.textContent = label;
    if (cls) d.className = cls;
    d.onclick = () => { menu.style.display='none'; fn(); };
    menu.appendChild(d);
  });
  menu.style.left = e.clientX + 'px';
  menu.style.top  = e.clientY + 'px';
  menu.style.display = 'block';
}
document.addEventListener('click', () => $('#ctxMenu').style.display = 'none');

function moveUp(id) {
  const parent = findParent(id);
  const list = parent ? parent.children : db.rootIds;
  const i = list.indexOf(id);
  if (i > 0) { [list[i-1], list[i]] = [list[i], list[i-1]]; saveDB(); renderTree(); }
}
function moveDown(id) {
  const parent = findParent(id);
  const list = parent ? parent.children : db.rootIds;
  const i = list.indexOf(id);
  if (i >= 0 && i < list.length - 1) { [list[i+1], list[i]] = [list[i], list[i+1]]; saveDB(); renderTree(); }
}

/* ---------- Import / Export BD ---------- */
function exportDB() {
  flushEditor();
  const data = JSON.stringify(db, null, 2);
  const blob = new Blob([data], { type:'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'treenotes-' + new Date().toISOString().slice(0,10) + '.json';
  a.click();
  URL.revokeObjectURL(a.href);
}

function importDB(ev) {
  const file = ev.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const data = JSON.parse(reader.result);
      if (!data.nodes || !data.rootIds) throw new Error('Format incorrecte');
      if (!confirm('Això substituirà la BD actual. Continuar?')) return;
      db = data;
      saveDB();
      renderTree();
      selectNote(db.selected || db.rootIds[0]);
      setStatus('BD importada');
    } catch(err) {
      alert('Error important: ' + err.message);
    }
    ev.target.value = '';
  };
  reader.readAsText(file);
}

/* ---------- Export HTML (només lectura, arbre sencer) ---------- */
function exportHTML() {
  flushEditor();
  const html = [];
  html.push('<!DOCTYPE html><html lang="ca"><head><meta charset="utf-8">');
  html.push('<title>TreeNotes export</title>');
  html.push('<style>body{font-family:system-ui,sans-serif;max-width:900px;margin:30px auto;padding:0 20px;line-height:1.6;}');
  html.push('details{margin:6px 0;border-left:2px solid #cbd5e0;padding-left:12px;}');
  html.push('summary{cursor:pointer;font-weight:600;padding:4px 0;}');
  html.push('h1,h2,h3{margin-top:1em;} pre{background:#f7fafc;border:1px solid #e2e8f0;padding:8px;border-radius:4px;white-space:pre-wrap;}');
  html.push('table{border-collapse:collapse;} td,th{border:1px solid #cbd5e0;padding:4px 8px;}');
  html.push('blockquote{border-left:3px solid #cbd5e0;padding-left:10px;color:#555;}</style></head><body>');
  html.push('<h1>TreeNotes — export</h1>');

  const render = (ids) => {
    for (const id of ids) {
      const n = db.nodes[id];
      if (!n) continue;
      html.push('<details open><summary>' + escapeHtml(n.title) + '</summary>');
      html.push('<div>' + (n.html || '') + '</div>');
      if (n.children.length) render(n.children);
      html.push('</details>');
    }
  };
  render(db.rootIds);
  html.push('</body></html>');

  const blob = new Blob([html.join('\n')], { type:'text/html' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'treenotes-' + new Date().toISOString().slice(0,10) + '.html';
  a.click();
  URL.revokeObjectURL(a.href);
}

function escapeHtml(s) {
  return (s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

/* ---------- Nova BD ---------- */
function newDB() {
  if (!confirm('Crear una BD nova? Es perdrà l\'actual (exporta-la abans!)')) return;
  db = blankDB();
  saveDB();
  renderTree();
  selectNote(db.selected);
}

/* ---------- Estat ---------- */
function setStatus(msg) {
  $('#statusLeft').textContent = msg;
  const total = Object.keys(db.nodes).length;
  $('#statusRight').textContent = total + ' notes';
}

/* ---------- Dreceres ---------- */
document.addEventListener('keydown', (e) => {
  if (e.ctrlKey || e.metaKey) {
    if (e.key === 's') { e.preventDefault(); flushEditor(); saveDB(); }
    if (e.key === 'b') { e.preventDefault(); fmt('bold'); }
    if (e.key === 'i') { e.preventDefault(); fmt('italic'); }
    if (e.key === 'u') { e.preventDefault(); fmt('underline'); }
  }
  if (e.key === 'Tab' && document.activeElement === $('#noteTitle')) {
    e.preventDefault();
    addNote(null, 'child');
  }
});

