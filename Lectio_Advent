function primerDomingoAdviento(y){
  const d = new Date(y,10,27);
  while(d.getDay()!==0) d.setDate(d.getDate()+1);
  return d;
}
function cicloDe(y){ // y = año en que comienza el Adviento
  const m = ((y%3)+3)%3;
  return m===1?'B':(m===2?'C':'A');
}
const DIAS = 86400000;
function dif(a,b){ return Math.round((a-b)/DIAS); }
function mismoDia(a,b){ return a.getFullYear()===b.getFullYear()&&a.getMonth()===b.getMonth()&&a.getDate()===b.getDate(); }

function guiaParaFecha(date){
  const y=date.getFullYear(), m=date.getMonth()+1, d=date.getDate();
  const a1 = primerDomingoAdviento(y);
  let ly, advent1;
  if(date >= a1){ ly=y; advent1=a1; }
  else {
    const ap = primerDomingoAdviento(y-1);
    if(date >= ap){ ly=y-1; advent1=ap; }
    else return null;
  }
  const cyc = cicloDe(ly);
  const ci = {A:0,B:1,C:2}[cyc];
  const diff = dif(date, advent1);
  if(diff < 0) return null;

  /* ---------- NAVIDAD ---------- */
  const navidad = new Date(ly,11,25);
  if(date >= navidad || m===1){
    // Sagrada Familia
    let sf;
    if(navidad.getDay()===0){ sf = new Date(ly,11,30); }
    else {
      sf = new Date(ly,11,26);
      while(sf.getDay()!==0) sf.setDate(sf.getDate()+1);
    }
    // Bautismo del Señor: primer domingo después del 6 de enero
    const baut = new Date(ly+1,0,7);
    while(baut.getDay()!==0) baut.setDate(baut.getDate()+1);
    // II domingo de Navidad: domingo entre el 2 y el 5 de enero
    let n2=null;
    for(let dd=2; dd<=5; dd++){
      const t=new Date(ly+1,0,dd);
      if(t.getDay()===0){ n2=t; break; }
    }
    if(m===12){
      if(mismoDia(date,sf)) return {n:[45,46,47][ci], cyc};
      const tabla = {25:38,26:39,27:40,28:41,29:42,30:43,31:44};
      if(tabla[d]) return {n:tabla[d], cyc};
      return null;
    }
    // enero
    if(mismoDia(date,baut)) return {n:[61,62,63][ci], cyc};
    if(date > baut) return null;
    if(d===1) return {n:49, cyc};
    if(n2 && mismoDia(date,n2)) return {n:48, cyc};
    if(d===6) return {n:54, cyc};
    if(d>=2 && d<=12) return {n:48+d, cyc};
    return null;
  }

  /* ---------- ADVIENTO ---------- */
  if(diff%7===0){
    const w = diff/7;
    if(w===0) return {n:[1,2,3][ci], cyc};
    if(w===1) return {n:[10,11,12][ci], cyc};
    if(w===2) return {n:[19,20,21][ci], cyc};
    if(w===3) return {n:[27,28,29][ci], cyc};
    return null;
  }
  // Del 17 al 24 de diciembre (guías por fecha)
  if(m===12 && d>=17 && d<=24) return {n:30+(d-17), cyc};
  if(diff>=1 && diff<=6) return {n:3+diff, cyc};
  if(diff>=8 && diff<=13) return {n:5+diff, cyc};
  if(diff>=15 && diff<=20) return {n:7+diff, cyc};
  return null;
}

/* ============================================================
   5. INTERFAZ
   ============================================================ */
const main = document.getElementById('main');
const lista = document.getElementById('lista');
const inputQ = document.getElementById('q');
const hint = document.getElementById('hint');
const sidebar = document.getElementById('sidebar');
const overlay = document.getElementById('overlay');
let actual = null;

function nombreCiclo(c){ return c ? 'Ciclo '+c : ''; }

function pintarLista(filtro=''){
  const f = filtro.trim().toLowerCase();
  const coincide = g => {
    if(!f) return true;
    return (g.t+' '+g.cit.join(' ')+' '+g.ev+' '+g.com+' '+g.med+' '+g.ora).toLowerCase().includes(f);
  };
  let html = '';
  html += `<div class="grupo"><h3>Introducción</h3>
    <button class="item" data-pres="1"><span class="n">ℹ</span><span class="txt">Presentación y método</span></button></div>`;

  const adv = GUIAS.filter(g=>g.n<=37 && coincide(g));
  const nav = GUIAS.filter(g=>g.n>=38 && coincide(g));

  if(adv.length){
    html += '<div class="grupo"><h3>Adviento</h3>';
    adv.forEach(g=>{
      html += `<button class="item" data-id="${g.n}">
        <span class="n">${g.n}</span>
        <span class="txt">${esc(g.t)}${g.c?`<span class="ciclo">${g.c}</span>`:''}</span>
      </button>`;
    });
    html += '</div>';
  }
  if(nav.length){
    html += '<div class="grupo"><h3>Navidad</h3>';
    nav.forEach(g=>{
      html += `<button class="item" data-id="${g.n}">
        <span class="n">${g.n}</span>
        <span class="txt">${esc(g.t)}${g.c?`<span class="ciclo">${g.c}</span>`:''}</span>
      </button>`;
    });
    html += '</div>';
  }
  if(!adv.length && !nav.length && f){
    html += '<div class="vacio">Sin resultados para «'+esc(filtro)+'»</div>';
  }
  lista.innerHTML = html;

  // marcar activo
  if(actual){
    const el = lista.querySelector(`.item[data-id="${actual}"]`);
    if(el) el.classList.add('activo');
  }
}

function pintarGuia(n){
  const g = GUIAS.find(x=>x.n===n);
  if(!g) return;
  actual = n;
  document.body.dataset.tiempo = n<=37 ? 'adviento' : 'navidad';

  const idx = GUIAS.findIndex(x=>x.n===n);
  const prev = GUIAS[idx-1], next = GUIAS[idx+1];

  main.innerHTML = `
  <div class="articulo">
    <div class="guia-head">
      <span class="num">${g.n}</span>
      ${g.c?`<span class="ciclo-badge">Ciclo ${g.c}</span>`:''}
      <h1>${esc(g.t)}</h1>
    </div>

    <div class="citas">
      <h2>Citas de la liturgia de la Misa</h2>
      <div class="chips">
        ${g.cit.map(c=>`<a class="chip" href="${urlBiblia(c)}" target="_blank" rel="noopener" title="Abrir en BibleGateway">${esc(c)}<span class="ext">↗</span></a>`).join('')}
      </div>
    </div>

    <section class="bloque leemos">
      <h2>Leemos</h2>
      <div class="evangelio">${parrafos(g.ev)}</div>
      <div class="comentario">${parrafos(g.com)}</div>
    </section>

    <section class="bloque meditamos">
      <h2>Meditamos</h2>
      ${listaMixta(g.med)}
    </section>

    <section class="bloque oramos">
      <h2>Oramos</h2>
      <div class="oracion-caja">${parrafos(g.ora)}</div>
    </section>

    <nav class="pager">
      <button ${prev?`data-id="${prev.n}"`:'disabled'}>
        <span class="dir">← Anterior</span>${prev?esc(prev.t+(prev.c?' · '+prev.c:'')):'—'}
      </button>
      <button ${next?`data-id="${next.n}"`:'disabled'} style="text-align:right">
        <span class="dir">Siguiente →</span>${next?esc(next.t+(next.c?' · '+next.c:'')):'—'}
      </button>
    </nav>
  </div>`;

  main.scrollTop = 0;
  pintarLista(inputQ.value);
  try{ localStorage.setItem('lectio_ultimo', n); }catch(e){}
  cerrarMenu();
}

function pintarPresentacion(){
  actual = null;
  document.body.dataset.tiempo = 'adviento';
  main.innerHTML = PRESENTACION;
  main.scrollTop = 0;
  pintarLista(inputQ.value);
  cerrarMenu();
}

function abrirMenu(){ sidebar.classList.add('abierto'); overlay.classList.add('visible'); }
function cerrarMenu(){ sidebar.classList.remove('abierto'); overlay.classList.remove('visible'); }

/* ---------- Eventos ---------- */
lista.addEventListener('click', e=>{
  const b = e.target.closest('.item');
  if(!b) return;
  if(b.dataset.pres){ pintarPresentacion(); return; }
  pintarGuia(Number(b.dataset.id));
});

main.addEventListener('click', e=>{
  const b = e.target.closest('.pager button[data-id]');
  if(b) pintarGuia(Number(b.dataset.id));
});

inputQ.addEventListener('input', ()=>{
  const f = inputQ.value.trim();
  pintarLista(f);
  if(f){
    const n = lista.querySelectorAll('.item[data-id]').length;
    hint.textContent = n===1 ? '1 guía encontrada' : n+' guías encontradas';
  } else {
    hint.textContent = 'Escribe para filtrar por día, cita o palabra';
  }
});

document.getElementById('hoyBtn').addEventListener('click', ()=>{
  const hoy = new Date();
  const r = guiaParaFecha(hoy);
  const fecha = hoy.toLocaleDateString('es-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
  if(r && GUIAS.some(g=>g.n===r.n)){
    pintarGuia(r.n);
    hint.textContent = 'Hoy · '+fecha;
  } else {
    main.innerHTML = `<div class="articulo">
      <div class="guia-head"><h1>Hoy</h1></div>
      <p class="sub">${fecha}</p>
      <div class="evangelio">
        <p>Hoy no hay ninguna guía de este volumen.</p>
        <p>La fecha actual corresponde al <b>Tiempo Ordinario</b> o a un tiempo litúrgico distinto de Adviento y Navidad, que se recogen en otros volúmenes de la colección.</p>
        <p>Puedes consultar cualquier día desde el menú lateral.</p>
      </div>
    </div>`;
    main.scrollTop = 0;
    actual = null;
    pintarLista(inputQ.value);
  }
  cerrarMenu();
});

document.getElementById('presBtn').addEventListener('click', pintarPresentacion);
document.getElementById('menuBtn').addEventListener('click', abrirMenu);
overlay.addEventListener('click', cerrarMenu);

document.addEventListener('keydown', e=>{
  if(e.target.tagName==='INPUT') return;
  if(e.key==='ArrowLeft'||e.key==='ArrowRight'){
    const idx = GUIAS.findIndex(x=>x.n===actual);
    if(idx<0) return;
    const t = e.key==='ArrowLeft' ? GUIAS[idx-1] : GUIAS[idx+1];
    if(t) pintarGuia(t.n);
  }
  if(e.key==='Escape') cerrarMenu();
});

/* ---------- Arranque ---------- */
pintarLista();
hint.textContent = 'Escribe para filtrar por día, cita o palabra';

// Intento de restaurar la última lectura; si no, se muestra la presentación
let ultimo = null;
try{ ultimo = Number(localStorage.getItem('lectio_ultimo')); }catch(e){}
if(ultimo && GUIAS.some(g=>g.n===ultimo)) pintarGuia(ultimo);
else pintarPresentacion();
</script>
