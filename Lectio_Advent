const CLAVES = Object.keys(LIBROS).sort((a,b)=>b.length-a.length);
const VERSION_BIBLIA = 'RVR1960';

function refParaWeb(cita){
  let s = cita.trim();
  let libro = '', resto = '';
  if(/^Sal\s+1\s+Sam/i.test(s)){
    libro = '1 Samuel'; resto = s.replace(/^Sal\s+1\s+Sam\s*/i,'');
  } else {
    for(const k of CLAVES){
      const re = new RegExp('^'+k.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'\\s+','i');
      if(re.test(s)){ libro = LIBROS[k]; resto = s.replace(re,''); break; }
    }
    if(!libro){ libro=''; resto=s; }
  }
  // Normalizar la parte numérica
  const partes = resto.split(';').map(p=>{
    p = p.replace(/[a-záéíóúü]/gi,'').trim();
    p = p.replace(/\./g,',');
    p = p.replace(/,\s*/g,',');       // sin espacios tras comas
    const i = p.indexOf(',');
    if(i>-1){ p = p.slice(0,i)+':'+p.slice(i+1); }
    return p;
  });
  return (libro? libro+' ' : '') + partes.join('; ');
}

function urlBiblia(cita){
  const ref = refParaWeb(cita);
  return 'https://www.biblegateway.com/passage/?search='+encodeURIComponent(ref)+'&version='+VERSION_BIBLIA;
}

function esc(t){ return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function parrafos(txt){
  return txt.split('\n').filter(l=>l.trim()!=='').map(l=>{
    const dlg = /^[−–-]/.test(l.trim());
    return '<p'+(dlg?' class="dlg"':'')+'>'+esc(l)+'</p>';
  }).join('');
}

function listaMixta(txt){
  const lineas = txt.split('\n').filter(l=>l.trim()!=='');
  let html='', buffer=[];
  const cerrar=()=>{ if(buffer.length){ html+='<ul>'+buffer.map(b=>'<li>'+esc(b)+'</li>').join('')+'</ul>'; buffer=[]; } };
  lineas.forEach(l=>{
    if(/^[•·\-–]\s/.test(l.trim())){ buffer.push(l.trim().replace(/^[•·\-–]\s*/,'')); }
    else { cerrar(); html += '<p>'+esc(l)+'</p>'; }
  });
  cerrar();
  return html;
}

